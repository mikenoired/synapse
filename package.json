{
	"name": "synapse",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*",
		"apps/*",
		"services/*"
	],
	"scripts": {
		"check": "bun run lint && bun run format:check && bun run typecheck && bun run test:thumbnail",
		"format": "bun x oxfmt --config .oxfmtrc.json --write .",
		"format:check": "bun x oxfmt --config .oxfmtrc.json --check .",
		"lint": "bun run lint:js",
		"lint:fix": "bun run lint:js:fix",
		"lint:js": "bun x oxlint . --config .oxlintrc.json --deny-warnings",
		"lint:js:fix": "bun x oxlint . --config .oxlintrc.json --fix",
		"test:thumbnail": "bun --filter @synapse/thumbnail-service test",
		"test:thumbnail:integration": "bun test ./test",
		"typecheck": "bun x tsc -p apps/web/tsconfig.json --noEmit && bun x tsc -p packages/ui/tsconfig.json --noEmit && bun --filter @synapse/thumbnail-service typecheck"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.0",
		"@grpc/proto-loader": "^0.8.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"typescript": "^6.0.2"
	}
}
